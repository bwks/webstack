<section id="items-region" class="space-y-4">
  <div id="item-errors" aria-live="polite"></div>
  <form class="card border border-base-300 bg-base-100" method="post" action="/items/{{ item.id }}"
        hx-put="/items/{{ item.id }}" hx-target="#items-region" hx-swap="outerHTML"
        hx-headers='{"X-CSRF-Token":"{{ csrf_token }}"}'
        hx-status:4xx="target:#item-errors" hx-status:5xx="target:#item-errors">
    <div class="card-body gap-5">
      <input type="hidden" name="_csrf" value="{{ csrf_token }}">
      <label class="form-control gap-2"><span class="label-text font-medium">Item name</span><input class="input input-bordered w-full" name="name" value="{{ item.name }}" minlength="1" maxlength="100" autofocus required></label>
      <div class="card-actions"><button class="btn btn-primary" type="submit">Save changes</button><a class="btn btn-ghost" href="/items" hx-get="/items" hx-target="#items-region" hx-swap="outerHTML">Cancel</a></div>
    </div>
  </form>
</section>
