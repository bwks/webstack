{% extends "base.html.jinja" %}

{% block title %}Sign in · Webstack Demo{% endblock %}

{% block content %}
<section class="card mx-auto w-full max-w-md border border-base-300 bg-base-100 shadow-xl shadow-base-300/20">
  <form class="card-body gap-5" method="post" action="/login">
    <div><p class="text-sm font-medium text-primary">Welcome back</p><h1 class="mt-1 text-3xl font-bold">Sign in</h1><p class="mt-2 text-sm text-base-content/60">Use your local Webstack account to continue.</p></div>
    {% if !message.is_empty() %}<div class="alert alert-warning text-sm" role="alert">{{ message }}</div>{% endif %}
    <input type="hidden" name="_csrf" value="{{ nav.csrf_token }}">
    <label class="form-control gap-2"><span class="label-text font-medium">Username</span><input class="input input-bordered w-full" name="username" autocomplete="username" autofocus required></label>
    <label class="form-control gap-2"><span class="label-text font-medium">Password</span><input class="input input-bordered w-full" type="password" name="password" autocomplete="current-password" required></label>
    <button class="btn btn-primary mt-1" type="submit">Sign in</button>
  </form>
</section>
{% endblock %}
